# e2e 环境描述。复制成 env（同目录，被 .gitignore 忽略）后按现场改。
#
# 矩阵要跑在集群内部的某台节点上：节点之间要能直连，从外面经端口转发够不着。
# 所以这些脚本连同 tools/e2e/*.py 一起铺到节点上执行，见 sync.sh。

# 三台节点的 API 地址，逗号分隔，按安装顺序
ND_NODES=http://192.168.10.3:8080,http://192.168.10.4:8080,http://192.168.10.5:8080
# 虚 IP：写入者永远在它上面
ND_VIP=192.168.10.250

ND_PASSWORD='<管理员口令>'          # 别把真口令写进 env.example，env 才是现场文件
ND_SSH_USER='<系统账号>'           # 非 root 时矩阵会自己套 sudo -S
ND_SSH_PASSWORD='<系统账号口令>'
ND_CLUSTER_TOKEN='<集群令牌>'

ND_POOL=tank                      # 数据池
ND_BACKUP_POOL=tank2              # 备份池，必须与数据池不同（backup_matrix 用）
ND_IMPORT_DIR=/var/lib/ndiskless/imports

# 能过导入体检的镜像源。没有它，boot / backup 两个矩阵会整段跳过（不会空跑）。
# 没有真实 Windows 镜像时，用 fixtures/mkwin.sh 造一个最小的。
ND_WINDOWS_SOURCE=/var/lib/ndiskless/imports/winmin.raw

# 跑本脚本的那台机器的 IP。failover_matrix 会做断电、断网这类致命注入，
# 不知道「自己在哪台上」就会把跑脚本的那台一起打断，命令超时、脚本挂死。
ND_RUNNER_IP=192.168.10.5

# 分级套件（topology.sh）专用
ND_HOSTS=192.168.10.3,192.168.10.4,192.168.10.5
ND_POOL_DISK=/dev/sdb             # 建数据池用的空盘
ND_BINARY=/tmp/ndiskless-new      # 节点上待安装的二进制
ND_SCRIPTS=/opt/ndiskless/scripts
ND_E2E_DIR=/home/${ND_SSH_USER}/e2e
